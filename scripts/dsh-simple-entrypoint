#!/bin/bash
set -euo pipefail

# Set DSH_SOCAT_ENABLED=0 to run the command without the TCP relay.
if [[ ${DSH_SOCAT_ENABLED:-1} != 1 ]]; then
  exec "$@"
fi

# Non-interactive Bash keeps both services in the group signalled by tini -g.
"$@" &
command_pid=$!
socat TCP4-LISTEN:3081,bind=0.0.0.0,reuseaddr,fork TCP4:127.0.0.1:3080 &

# Exiting the entrypoint ends the container when either service exits.
wait -n "$command_pid" "$!"
